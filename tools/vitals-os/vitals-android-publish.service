[Unit]
Description=Publish the newest verified, durably signed Vitals OS Android app to the local downloads directory

[Service]
Type=oneshot
Environment=PATH=%h/.local/opt/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PULSE_DESKTOP_DOWNLOADS_DIR=%h/pulse-downloads/desktop
Environment=VITALS_ANDROID_BRANCHES=main,validation/mobile-shell
ExecStart=/usr/bin/env node %h/pulse-downloads/bin/publish-android.mjs
TimeoutStartSec=900
Nice=10
