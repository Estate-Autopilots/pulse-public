[Unit]
Description=Pulse production Drive metadata stopgap (accepted importer, no source writes)
[Service]
Type=oneshot
Environment=PATH=/home/eadev/.local/opt/node/bin:/home/eadev/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/estate-autopilots/db/pulse.env
# POLISH-2: the stable launcher runs the shipped release checkout's own tools/drive-refresh-run.py (no installed copy to go stale).
ExecStart=/usr/bin/python3 /home/eadev/.local/lib/pulse-release/release-run.py drive-refresh-run.py
Nice=19
CPUWeight=20
TimeoutStartSec=infinity
