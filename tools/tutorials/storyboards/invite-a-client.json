   "to": "given",
   "to_offset": 30,
   "line": {
    "en": {
     "say": "Give them a task in one line.",
     "cap": "Give them a *task* in one line."
    },
    "hi": {
     "say": "एक line में task दीजिए।",
     "cap": "Ek line mein *task* dijiye."
    }
   },
   "chapter": {
    "en": "Give a task",
    "hi": "Task dijiye"
