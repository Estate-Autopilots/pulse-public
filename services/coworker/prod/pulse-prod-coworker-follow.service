# EA-AI: move production's AI runtime to production's live release when a deploy changed it (restarts it then).
[Unit]
Description=Pulse production: keep the AI runtime on the live release
[Service]
Type=oneshot
Environment=PATH=%h/.local/opt/node/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/pulse-prod-coworker-follow
Nice=15
