{
  "rule_version": "delivery-rules/v2",
  "tenant_config": {
    "folder_rules": {
      "subfolders": [
        {"match": "video editing details", "role": "input:edit_brief"},
        {"match": "project blueprint", "role": "input:blueprint_folder", "nested": true},
        {"match": "research(\\s+and)?\\s+scripts?", "role": "input:research"},
        {"match": "(shoot\\s+)?raw(\\s+(files|footage))?|shoot raw files", "role": "input:raw_footage"},
        {"match": "model\\s+final\\s+videos?(\\s+and)?(\\s+its)?\\s+hooks?|final\\s+videos?(\\s+and\\s+hooks?)?", "role": "deliverables", "default_version_kind": "final"},
        {"match": "vovs?(\\s+and\\s+designs?)?", "role": "deliverables", "default_version_kind": "final"},
        {"match": "creatives?", "role": "deliverables", "default_version_kind": "final"},
        {"match": "(cp\\s+video|landing\\s+page|founders?\\s+video|brand\\s*film|client\\s+testimonials?)(.*)", "role": "deliverables", "default_version_kind": "final"},
        {"match": "drafts?", "role": "deliverables", "default_version_kind": "draft", "nested": true},
        {"match": "leads?", "role": "ignore"}
      ],
      "file_name": {
        "legacy_version_tokens": ["v\\d+", "final", "revised", "rev\\s*\\d*", "\\(\\d+\\)", "copy"],
        "legacy_type_hints": {
          "hook\\s*\\d": "HK",
          "\\bCP\\d{0,3}\\b": "CP",
          "vov": "VV",
          "model": "MV",
          "walk\\s*through": "WT",
          "founder": "FV",
          "testimonial": "TS"
        }
      },
      "creative_type_rules": {
        "folder_path": [
          {"match": "model\\s+final\\s+videos?(?:\\s+and(?:\\s+its)?\\s+hooks?)?|final\\s+videos?(?:\\s+and\\s+hooks?)?", "type": "model_video"},
          {"match": "vovs?(?:\\s+and\\s+designs?)?", "type": "vov"},
          {"match": "cp\\s+videos?", "type": "vov"},
          {"match": "founders?\\s+videos?", "type": "founder_video"},
          {"match": "client\\s+testimonials?", "type": "testimonial"},
          {"match": "walkthroughs?|walk\\s+throughs?", "type": "walkthrough"}
        ],
        "file_name": [
          {"match": "\\bmodel(?:[-\\s]led)?\\s+video\\b", "type": "model_video"},
          {"match": "\\bvov\\b", "type": "vov"},
          {"match": "\\bcp[-\\s]+videos?\\b", "type": "vov"},
          {"match": "\\bfounders?[-\\s]+videos?\\b", "type": "founder_video"},
          {"match": "\\btestimonials?\\b", "type": "testimonial"},
          {"match": "\\bwalk[\\s-]*throughs?\\b", "type": "walkthrough"}
        ],
        "parsed_type_codes": {
          "MV": "model_video",
          "HK": "model_video",
          "VV": "vov",
          "CP": "vov",
          "FV": "founder_video",
          "TS": "testimonial",
          "WT": "walkthrough"
        }
      },
      "design_type_rules": {
        "folder_path": [
          {"match": "single[-\\s]+image[-\\s]+ads?", "type": "single_image_ad"},
          {"match": "carousels?", "type": "carousel"},
          {"match": "brochures?", "type": "brochure"},
          {"match": "logos?|brand marks?", "type": "logo"},
          {"match": "pitch[-\\s]+decks?", "type": "pitch_deck"}
        ],
        "file_name": [
          {"match": "\\bbrand[-\\s]+mark\\b", "type": "logo"}
        ]
      }
    }
  },
  "design_type_precedence_cases": [
    {"id": "design-client-logos-excluded", "folder_path": ["Client logos"], "expected": "other"},
    {"id": "design-bank-logos-kept", "folder_path": ["Bank Logos"], "expected": "logo"},
    {"id": "design-brochure-references-excluded", "folder_path": ["Brochure references"], "expected": "other"},
    {"id": "design-builder-input-excluded", "folder_path": ["Old brochure from builder"], "expected": "other"},
    {"id": "design-deepest-folder-wins", "folder_path": ["Brochures", "Logos"], "expected": "logo"},
    {"id": "design-client-video-shoot-carousel-kept", "folder_path": ["Client Video Shoot", "Project A", "Carousels"], "expected": "carousel"},
    {"id": "design-client-video-shoot-single-image-kept", "folder_path": ["Client Video Shoot", "Project A", "Single Image Ads"], "expected": "single_image_ad"},
    {"id": "design-inner-reference-excluded-under-brochures", "folder_path": ["Brochures", "References"], "expected": "other"}
  ],
  "legacy_names": [
