<?xml version="1.0" encoding="utf-8"?>
<!-- Pulse widget, medium (3×2): status since, time worked as of the last confirmation, the next shift, one action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/attendance_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/attendance_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pulse" android:textColor="@color/pulse_action" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/attendance_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Open Pulse to sign in" android:textSize="16sp" android:textColor="@color/pulse_widget_text" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/attendance_worked" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/pulse_widget_text" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
    <TextView android:id="@+id/attendance_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="13sp" android:textColor="@color/pulse_widget_muted" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
    <TextView android:id="@+id/attendance_updated" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:text="No saved status" android:textSize="12sp" android:textColor="@color/pulse_widget_muted" android:maxLines="2" android:ellipsize="end" />
    <Button android:id="@+id/attendance_primary" android:layout_width="match_parent" android:layout_height="48dp" android:text="Open Workspace" android:textAllCaps="false" android:textColor="@color/pulse_action" />
</LinearLayout>
