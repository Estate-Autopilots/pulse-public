export type Kind = "contact" | "talk" | "doc" | "media" | "answers" | "money" | "verdict" | "slot" | "list" | "any";
type Port = { key: string; label: string; kind: Kind; required?: boolean; many?: boolean };
type Mod = { key: string; name: string; icon: string; needs: Port[]; makes: Port[]; engine: string; converter?: boolean };
type Cond = { field: string; op: string; value?: string | number | boolean | null; values?: string[] };
type Step = { id: string; module: string; stage?: string | null; pos: { x: number; y: number }; when?: Cond[]; block?: string | null; settings?: Record<string, unknown> };
type Kindish = { key: string; label: string; module: string; settings?: Record<string, unknown> };
type Wire = { from: { step: string; port: string }; to: { step: string; port: string } };
type Def<S extends Step = Step> = { stages: { key: string; label: string }[]; steps: S[]; wires: Wire[] };
type Due = { days: number | Record<string, number>; field?: string } | null | undefined;
export type Band = { key: string; label: string; x: number; y: number; w: number; h: number; steps: number };
export type Box = { x: number; y: number; w: number; h: number };
export type WireCheck = { ok: boolean; why: string | null; fromKind: Kind; toKind: Kind; converters: string[] };

export declare const NODE: { w: number; head: number; row: number; pad: number };
export declare const BAND: { pad: number; top: number; gap: number; minW: number; gapX: number; gapY: number };
export declare const KINDS: Kind[];
export declare function fits(from: Kind, to: Kind): boolean;
export declare function snap(n: number, grid?: number): number;
export declare const IN: Port;
export declare function moduleOf<M extends Mod>(step: Step, byKey: Record<string, M>): M & { kindLabel?: string | null };
export declare function kindOf<K extends Kindish>(step: Step, pr: { kinds?: K[] } | null | undefined): K | null;
export declare function nodeHeight(mod: Mod | undefined): number;
export declare function portPoint(step: Step, mod: Mod, side: "needs" | "makes", key: string): { x: number; y: number };
export declare function wirePath(a: { x: number; y: number }, b: { x: number; y: number }): string;
export declare function wireMid(a: { x: number; y: number }, b: { x: number; y: number }): { x: number; y: number };
export declare function checkWire(def: Def, byKey: Record<string, Mod>, modules: Mod[], wire: Wire): WireCheck;
export declare function convertersFor(modules: Mod[], from: Kind, to: Kind): string[];
export declare function article(kind: Kind): string;
export declare function wireTo(def: Def, byKey: Record<string, Mod>, from: { step: string; port: string }, to: string, inKey?: string | null):
  { ok: false; why: string } | { ok: true; port: string; fits: boolean; kind: Kind; need: Kind };
export declare function stepRuns(step: { when?: Cond[] }, values: Record<string, unknown> | null | undefined): boolean;
export declare function dueDays(due: Due, values: Record<string, unknown> | null | undefined): number | null;
export declare function layout<D extends Def>(def: D, byKey: Record<string, Mod>, force?: boolean): D;
export declare function bands(def: Def, byKey: Record<string, Mod>): Band[];
export declare function bandAt(list: Band[], x: number): string | null;
export declare function extent(def: Def, byKey: Record<string, Mod>, bandList?: Band[]): Box;
export declare function fitView(box: Box, view: { w: number; h: number }, margin?: number): { k: number; x: number; y: number };
export declare function freeSpot(def: Def, byKey: Record<string, Mod>, at: { x: number; y: number }): { x: number; y: number };
export declare function newId(def: Def, base?: string): string;
