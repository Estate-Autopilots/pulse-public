export const IST_MS: number;
export function istDay(ms: number): string;
export function istClock(ms: number): string;
type Due = { status: string; dueAt?: string | null; dueOn?: string | null };
type Scored = Due & { id: string; title: string; priority?: string; valuePoints?: number | null; points?: number | null; suggestedPoints?: number | null; openBlockers?: number; waiting?: number; estimateMinutes?: number | null; suggestion?: { effortMinutes?: number | null } | null };
export type Urgency = { key: "overdue" | "today" | "tomorrow" | "week" | "later" | "none" | "done"; text: string; short: string; tone: "late" | "now" | "soon" | "calm" | "none"; hoursLeft: number | null };
export function dueMs(task: Due): number | null;
export function urgency(task: Due, now?: number): Urgency;
export const FOCUS: { key: "overdue" | "today" | "week" | "later" | "none"; label: string }[];
export function focusGroup(task: Due, now?: number): "overdue" | "today" | "week" | "later" | "none" | "done";
export function sizeHours(task: { estimateMinutes?: number | null; suggestion?: { effortMinutes?: number | null } | null }): number | null;
export function focusScore(task: Scored, now?: number): number;
export function todaysFocus<T extends Scored>(tasks: T[], now?: number, n?: number): T[];
export function nextUp<T extends Scored>(tasks: T[], doneId: string, now?: number): T | null;
export type Step = { n: number; text: string; key: string };
export function stepKey(text: string): string;
export function parseNotes(notes: string | null | undefined): { intro: string[]; steps: Step[]; outro: string[] };
export function places(text: string | null | undefined): { label: string; href: string }[];
export function links(text: string | null | undefined): { label: string; href: string }[];
export function whyLine(task: { valueNote?: string | null; notes?: string | null }, projectSummary?: string | null): string | null;
export function stem(word: string): string;
export function workTokens(title: string): string[];
export function sameWork(a: string, b: string): number;
export const SAME_WORK_AT: number;
