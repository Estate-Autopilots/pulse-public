export type Stage = "idea" | "draft" | "design" | "review" | "approved" | "scheduled" | "posted" | "measured";
export type Channel = "linkedin" | "x" | "instagram" | "whatsapp_status" | "newsletter";
export type View = "strategy" | "calendar" | "board" | "library" | "kit" | "insights";
export type ChannelPlan = { key: Channel; perWeek: number; days: number[]; times: string[]; note?: string };
export const STAGES: Stage[];
export const STAGE_WORDS: Record<Stage, string>;
export const CHANNELS: Channel[];
export const CHANNEL_WORDS: Record<Channel, string>;
export const VIEWS: View[];
export const VIEW_WORDS: Record<View, string>;
export const DOW_SHORT: string[];
export const MONTHS: string[];
export const PILLAR_HUES: string[];
export const METRIC_WORDS: Record<string, string>;
export function isDay(s: unknown): boolean;
export function addDays(day: string, n: number): string;
export function dow(day: string): number;
export function weekStart(day: string): string;
export function weekDays(day: string): string[];
export function monthGrid(day: string): string[];
export function addMonths(day: string, n: number): string;
export function monthTitle(day: string): string;
export function dayTitle(day: string): string;
export function weekTitle(day: string): string;
export function range(view: string, day: string): { from: string; to: string };
export function step(view: string, day: string, dir: number): string;
export function hourOf(time: string | null | undefined): number | null;
export function nextStage(stage: Stage): Stage | null;
export function nextAction(post: { stage: Stage }, okNeeded: boolean): { to: Stage | null; label: string };
export function rhythm(channels: ChannelPlan[] | null | undefined, day: string): { channel: Channel; time: string }[];
export function bestTime(channels: ChannelPlan[] | null | undefined, channel: string): string | null;
export function captionToCopy(caption: string | null | undefined, hashtags: string[] | null | undefined): string;
export function tagsIn(caption: string | null | undefined): string[];
export function num(n: unknown): string;
export function linesOf(rows: Record<string, unknown>[] | null | undefined, fields: string[]): string;
export function rowsOf(text: string, fields: string[]): Record<string, string>[];
