{
  "name": "@pulse/cli",
  "version": "1.0.0",
  "description": "The pulse command: sign in with your Pulse account and use Pulse API v1 from a terminal or script",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20" },
  "bin": { "pulse": "dist/cli.js" },
  "files": ["dist/*.js", "README.md"],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc -p tsconfig.json && node scripts/pack.mjs",
    "lint": "node scripts/generate.mjs --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && node --test --test-concurrency=2 test/*.test.mjs"
  },
  "devDependencies": { "@types/node": "24.19.1", "typescript": "5.9.3" }
}
