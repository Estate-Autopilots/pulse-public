{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pulse.estateautopilots.com/schemas/connector.v1/manifest.json",
  "title": "Pulse company connector manifest (connector.v1, R52)",
  "description": "What one connector may do for one company: the provider scopes it asks for and why, the kinds of root a company admin can select, and the only entities (registered event types, at a data schema version Pulse supports) it may deliver. EA Connect is one implementation (pull: Pulse reads with the company's own Google credential); a company's own plugin pushes signed batches (batch.v1.json). The company is never named here or in a batch: it is the company that installed the connector. Changing the scopes, entity types, data schemas or the reasons given needs a new version, and a new version applies only after that company's admin grants it. x-entity-scopes names the provider scope each entity needs; the database (pulse.connector_manifest_ok, migration 0470) keeps the same lists.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "key", "name", "version", "publisher", "transport", "auth", "scopes", "sources", "entities"],
  "properties": {
    "contract": { "const": "connector.v1" },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 60 },
    "version": { "type": "string", "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$" },
    "publisher": { "type": "string", "minLength": 2, "maxLength": 80 },
    "transport": { "enum": ["pull", "push"] },
    "auth": { "enum": ["google_service_account", "signed_push"] },
    "scopes": {
      "type": "array", "minItems": 1, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["scope", "why"],
        "properties": {
          "scope": { "enum": ["https://www.googleapis.com/auth/drive.metadata.readonly"] },
          "why": { "type": "string", "minLength": 10, "maxLength": 300 }
        }
      }
    },
    "sources": { "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": { "enum": ["shared_drive", "folder"] } },
    "entities": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["type", "schema"],
        "properties": {
          "type": { "enum": ["drive.file.created", "drive.file.updated", "drive.file.moved", "drive.file.renamed", "drive.file.trashed", "drive.folder.created"] },
          "schema": { "enum": [1] }
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "transport": { "const": "pull" } } }, "then": { "properties": { "auth": { "const": "google_service_account" } } } },
    { "if": { "properties": { "transport": { "const": "push" } } }, "then": { "properties": { "auth": { "const": "signed_push" } } } }
  ],
  "x-entity-scopes": {
    "drive.file.created": "https://www.googleapis.com/auth/drive.metadata.readonly",
    "drive.file.updated": "https://www.googleapis.com/auth/drive.metadata.readonly",
    "drive.file.moved": "https://www.googleapis.com/auth/drive.metadata.readonly",
    "drive.file.renamed": "https://www.googleapis.com/auth/drive.metadata.readonly",
    "drive.file.trashed": "https://www.googleapis.com/auth/drive.metadata.readonly",
    "drive.folder.created": "https://www.googleapis.com/auth/drive.metadata.readonly"
  }
}
