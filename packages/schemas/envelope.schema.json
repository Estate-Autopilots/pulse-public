{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema:pulse.event-envelope/1",
  "title": "Pulse event envelope (CloudEvents 1.0.2 structured JSON + Pulse extensions)",
  "description": "Every event accepted by POST /v1/events must validate against this schema and against the data schema registered for its type. See 02-domain-model.md §3.",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "time",
    "subject",
    "orgid",
    "purpose",
    "sensitivity",
    "visibility",
    "data"
  ],
  "additionalProperties": false,
  "properties": {
    "specversion": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "ULID. Collector-derived events use a deterministic ULID: 48-bit timestamp = event time, 80 random bits = first 80 bits of sha256(source|source_ref|type|ordinal), so re-normalising raw_inbox reproduces the same id (02 §3.2)"
    },
    "source": {
      "type": "string",
      "pattern": "^/(collectors|agent|api|edge|system)/[A-Za-z0-9._~/-]+$"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*){1,3}$",
      "description": "<domain>.<entity>.<verb>, registered in packages/schemas/registry.yaml"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z_]+:[a-z0-9_]+:.+$",
      "description": "<kind>:<namespace>:<key>, e.g. file:gdrive:1AbC"
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "dataschema": {
      "type": "string",
      "pattern": "^schema:[a-z0-9_.]+/[0-9]+$"
    },
    "orgid": {
      "type": "string",
      "format": "uuid"
    },
    "actor": {
      "type": "string",
      "pattern": "^(person|account|device|system|ai|external):[a-z0-9_]+:.+$"
    },
    "actorkind": {
      "enum": [
        "person",
        "account",
        "device",
        "system",
        "ai",
        "external"
      ]
    },
    "project": {
      "type": "string",
      "pattern": "^project:pulse:[0-9a-f-]{36}$"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 1
    },
    "purpose": {
      "type": "string",
      "pattern": "^(delivery|quality|coaching|voice|workload|outcomes|activity_context|after_hours|work_delta|command_counts|wellbeing|presence|office|security|privacy|billing)(,(delivery|quality|coaching|voice|workload|outcomes|activity_context|after_hours|work_delta|command_counts|wellbeing|presence|office|security|privacy|billing))*$",
      "description": "Comma-separated canonical purpose codes (privacy.purpose; appendix D header)"
    },
    "consentref": {
      "type": "string",
      "pattern": "^(notice|consent):.+$"
    },
    "sensitivity": {
      "type": "integer",
      "enum": [
        0,
        1,
        2
      ],
      "description": "0 organisational, 1 personal, 2 sensitive personal. 3 (special) must never be emitted."
    },
    "visibility": {
      "enum": [
        "person",
        "team",
        "org"
      ]
    },
    "causationid": {
      "type": "string"
    },
    "correlationid": {
      "type": "string"
    },
    "supersedes": {
      "type": "string"
    },
    "collectorver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+"
    },
    "data": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent.usage.hourly"
          }
        }
      },
      "then": {
        "properties": {
          "visibility": {
            "const": "person"
          },
          "data": {
            "type": "object",
            "required": [
              "hour_start",
              "categories",
              "active_s",
              "idle_s"
            ],
            "additionalProperties": false,
            "properties": {
              "hour_start": {
                "type": "string",
                "format": "date-time"
              },
              "active_s": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3600
              },
              "idle_s": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3600
              },
              "categories": {
                "type": "object",
                "description": "active seconds per category; keys from a fixed enum (no app names, window titles or URLs)",
                "additionalProperties": false,
                "properties": {
                  "editing": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3600
                  },
                  "design": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3600
                  },
                  "audio": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3600
                  },
                  "ai_tools": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3600
                  },
                  "communication": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3600
                  },
                  "browser": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3600
                  },
                  "office_docs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3600
                  },
                  "other": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3600
                  }
                }
              },
              "after_hours": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent.cid_time.hourly"
          }
        }
      },
      "then": {
        "properties": {
          "visibility": {
            "const": "person"
          },
          "data": {
            "type": "object",
            "required": [
              "hour_start",
              "minutes_by_cid"
            ],
            "additionalProperties": false,
            "properties": {
              "hour_start": {
                "type": "string",
                "format": "date-time"
              },
              "minutes_by_cid": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[A-Z]{2,4}\\d{4,6}-[A-Z]{2}\\d{2,3}$"
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 60
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "app.work.delta"
          }
        }
      },
      "then": {
        "properties": {
          "visibility": {
            "const": "person"
          },
          "data": {
            "type": "object",
            "required": [
              "app",
              "project_name_hash",
              "from_save",
              "to_save",
              "counts",
              "net_ewu",
              "gross_ewu"
            ],
            "additionalProperties": false,
            "description": "Counts only (03 S24): no clip, file, media, title, marker or effect names or values",
            "properties": {
              "app": {
                "enum": [
                  "premiere_pro",
                  "after_effects",
                  "photoshop",
                  "figma"
                ]
              },
              "project_name_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "cid": {
                "type": "string",
                "pattern": "^[A-Z]{2,4}\\d{4,6}-[A-Z]{2}\\d{2,3}$"
              },
              "from_save": {
                "type": "string",
                "format": "date-time"
              },
              "to_save": {
                "type": "string",
                "format": "date-time"
              },
              "baseline": {
                "type": "boolean",
                "description": "first snapshot of a project file: no delta credited"
              },
              "counts": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "clip_added": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "clip_removed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "cut": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "trim": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "move": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "effect_added": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "effect_removed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "effect_changed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "keyframe_added": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "keyframe_removed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "title_added": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "title_changed": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "marker_added": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "nest_created": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "transition_added": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  },
                  "bulk_op": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                  }
                }
              },
              "timeline_ms": {
                "type": "integer",
                "minimum": 0
              },
              "net_ewu": {
                "type": "number",
                "minimum": 0
              },
              "gross_ewu": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "agent.commands.hourly"
          }
        }
      },
      "then": {
        "properties": {
          "visibility": {
            "const": "person"
          },
          "purpose": {
            "const": "command_counts"
          },
          "data": {
            "type": "object",
            "required": [
              "hour_start",
              "app",
              "source",
              "counts"
            ],
            "additionalProperties": false,
            "description": "Category totals per hour (03 S25): never key codes, characters, sequences or per-press times",
            "properties": {
              "hour_start": {
                "type": "string",
                "format": "date-time"
              },
              "app": {
                "enum": [
                  "premiere_pro",
                  "after_effects",
                  "photoshop"
                ]
              },
              "source": {
                "enum": [
                  "app_events",
                  "keyboard"
                ]
              },
              "counts": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "cut_trim": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20000
                  },
                  "select_move": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20000
                  },
                  "playback_navigate": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20000
                  },
                  "effects_colour": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20000
                  },
                  "audio": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20000
                  },
                  "titles_graphics": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20000
                  },
                  "markers": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20000
                  },
                  "undo_redo": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20000
                  },
                  "export_render": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20000
                  },
                  "other_edit": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 20000
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
